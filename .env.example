# Ledgerkeep configuration. Every value here has a safe default: with an empty
# .env the whole loop runs offline, keyless, against the fixture ledger. You only
# set these to move onto the live ASI / Fetch.ai testnet path.

# --- offline / keyless operation (default: on) -------------------------------
# Leave on to run against the in-repo fixture ledger with no network.
LEDGERKEEP_OFFLINE=1
LEDGERKEEP_IN_MEMORY_STATE=1

# --- ASI / Fetch.ai marketplace (testnet only during the grant) --------------
# Set a seed phrase and install the `uagents` extra to publish the service as a
# uAgents endpoint on Agentverse. A network other than a test network is refused.
LEDGERKEEP_ASI_AGENT_SEED=
LEDGERKEEP_ASI_NETWORK=testnet
LEDGERKEEP_ASI_SERVICE_TITLE=Ledgerkeep: guardrailed autonomous operations agent

# --- guardrail toggles (safe defaults; tighten as needed) --------------------
LEDGERKEEP_DRY_RUN=0
LEDGERKEEP_MAX_ACTIONS_PER_CYCLE=4
LEDGERKEEP_MAX_ACTIONS_PER_HOUR=20

# --- durable state (optional; in-memory by default) --------------------------
# Point at Firestore for a run history that survives a restart. Unset -> memory.
# GOOGLE_CLOUD_PROJECT=
# LEDGERKEEP_FIRESTORE_COLLECTION=ledgerkeep_runs
